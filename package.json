{
  "name": "sprite-sheet-tool",
  "version": "1.0.0",
  "private": true,
  "author": "OpenAI Codex",
  "description": "Desktop sprite sheet and frame animation tool for game VFX artists.",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "clean:artifacts": "node scripts/clean-build-artifacts.mjs",
    "dev": "electron-vite dev",
    "build": "npm run clean:artifacts && electron-vite build",
    "icon:generate": "node scripts/generate-icons.mjs",
    "lint": "eslint . --max-warnings=0",
    "package:nsis": "npm run build && npm run icon:generate && npm run sign:report && electron-builder --win nsis --publish never -c.artifactName=${productName}-${version}-setup.${ext}",
    "package:portable": "npm run build && npm run icon:generate && npm run sign:report && electron-builder --win portable --publish never -c.artifactName=${productName}-${version}-portable.${ext}",
    "package:win": "npm run package:portable && npm run package:nsis",
    "regression:e2e": "node scripts/electron-regression.mjs",
    "sign:report": "node scripts/report-signing.mjs",
    "smoke": "node scripts/electron-smoke.mjs",
    "start:built": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-context-menu": "^2.2.16",
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "electron": "^38.3.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^4.0.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "playwright": "^1.58.2",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.codex.spritesheettool",
    "asar": true,
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "productName": "Sprite Sheet Tool",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/installerIcon.ico",
      "oneClick": false,
      "shortcutName": "Sprite Sheet Tool",
      "uninstallerIcon": "build/uninstallerIcon.ico"
    }
  }
}
